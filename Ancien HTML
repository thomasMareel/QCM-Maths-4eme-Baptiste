<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QCM Mathématiques — Baptiste (6e · 5e · 4e)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,800;1,9..144,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
  :root {
    --paper: #f4ede0;
    --paper-deep: #ebe1ce;
    --ink: #1a2540;
    --ink-soft: #3c4663;
    --accent: #d94f37;
    --accent-deep: #b03826;
    --success: #2f6b3f;
    --rule: #c9bca0;
    --shadow: 0 1px 0 rgba(26,37,64,.04), 0 12px 28px -16px rgba(26,37,64,.25);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    line-height: 1.55;
    min-height: 100vh;
  }

  body {
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 31px, rgba(26,37,64,.06) 31px, rgba(26,37,64,.06) 32px),
      radial-gradient(ellipse at top left, rgba(217,79,55,.04), transparent 50%);
    padding: 40px 20px 80px;
  }

  .container {
    max-width: 780px;
    margin: 0 auto;
  }

  /* ====== EN-TÊTE ====== */
  .masthead {
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 20px 0 16px;
    margin-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px;
  }

  .masthead-left .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .masthead-left h1 {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .masthead-left h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  .masthead-right {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    text-align: right;
    line-height: 1.6;
  }

  /* ====== ÉCRAN D'ACCUEIL ====== */
  .intro-card {
    background: #fffaf0;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
    padding: 40px 36px;
    border-radius: 2px;
    position: relative;
  }

  .intro-card::before {
    content: "";
    position: absolute;
    top: -1px; left: -1px; right: -1px;
    height: 6px;
    background: var(--accent);
  }

  .intro-card h2 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 24px;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .intro-card p {
    color: var(--ink-soft);
    margin-bottom: 12px;
  }

  .rules {
    list-style: none;
    margin: 24px 0;
    border-top: 1px dashed var(--rule);
    border-bottom: 1px dashed var(--rule);
    padding: 16px 0;
  }

  .rules li {
    padding: 8px 0;
    display: flex;
    gap: 14px;
    align-items: baseline;
  }

  .rules li::before {
    content: counter(rule, decimal-leading-zero);
    counter-increment: rule;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    font-weight: 600;
    min-width: 28px;
  }

  .rules { counter-reset: rule; }

  .name-field {
    margin: 24px 0;
  }

  .name-field label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }

  .name-field input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--ink);
    padding: 8px 0;
    font-family: 'Fraunces', serif;
    font-size: 22px;
    color: var(--ink);
    outline: none;
    transition: border-color .2s;
  }

  .name-field input:focus { border-color: var(--accent); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: var(--paper);
    border: none;
    padding: 16px 28px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 2px;
    transition: transform .15s, background .2s;
    box-shadow: 0 4px 0 var(--accent-deep);
  }

  .btn:hover {
    background: var(--accent);
    transform: translate(0, -1px);
  }

  .btn:active {
    transform: translate(0, 2px);
    box-shadow: 0 2px 0 var(--accent-deep);
  }

  .btn.secondary {
    background: transparent;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    box-shadow: none;
  }

  .btn.secondary:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* ====== ÉCRAN QUIZ ====== */
  .quiz-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    padding: 16px 0 14px;
    margin: -8px 0 28px;
    border-bottom: 1px solid var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .progress-wrap {
    flex: 1;
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    margin-bottom: 6px;
    letter-spacing: 0.05em;
  }

  .progress-bar {
    height: 3px;
    background: var(--paper-deep);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent);
    width: 0%;
    transition: width .3s ease;
  }

  .timer {
    font-family: 'JetBrains Mono', monospace;
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    padding: 8px 14px;
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    background: #fffaf0;
    min-width: 110px;
    text-align: center;
  }

  .timer.warning { color: var(--accent); border-color: var(--accent); }
  .timer.critical {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
    animation: pulse 1s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .question-card {
    background: #fffaf0;
    border: 1px solid var(--rule);
    padding: 32px 32px 28px;
    margin-bottom: 24px;
    border-radius: 2px;
    box-shadow: var(--shadow);
    position: relative;
  }

  .question-card .level-tag {
    position: absolute;
    top: -10px;
    left: 24px;
    background: var(--paper);
    padding: 2px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--rule);
  }

  .question-card .q-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    margin-bottom: 10px;
  }

  .question-card .q-text {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 24px;
    color: var(--ink);
  }

  .options {
    display: grid;
    gap: 10px;
  }

  .option {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border: 1.5px solid var(--rule);
    border-radius: 2px;
    cursor: pointer;
    transition: all .15s;
    background: #fff;
    font-size: 16px;
  }

  .option:hover {
    border-color: var(--ink);
    transform: translateX(2px);
  }

  .option input {
    appearance: none;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--ink-soft);
    border-radius: 50%;
    cursor: pointer;
    flex-shrink: 0;
    position: relative;
    transition: border-color .15s;
  }

  .option input:checked {
    border-color: var(--accent);
    border-width: 5px;
  }

  .option:has(input:checked) {
    border-color: var(--accent);
    background: rgba(217,79,55,.04);
  }

  .option .opt-letter {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    color: var(--ink-soft);
    font-size: 13px;
  }

  .option:has(input:checked) .opt-letter { color: var(--accent); }

  .option .opt-text { flex: 1; }

  .nav-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 32px;
    gap: 12px;
  }

  /* ====== ÉCRAN RÉSULTATS ====== */
  .results-hero {
    text-align: center;
    padding: 48px 24px 40px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 40px;
  }

  .results-hero .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .results-hero .score-big {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: clamp(80px, 16vw, 140px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .results-hero .score-big .sep {
    color: var(--accent);
    font-style: italic;
    font-weight: 400;
  }

  .results-hero .score-big .max {
    font-size: 0.5em;
    color: var(--ink-soft);
    font-weight: 400;
  }

  .results-hero .verdict {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 22px;
    color: var(--ink-soft);
    margin-top: 16px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--rule);
    margin-bottom: 48px;
    border: 1px solid var(--rule);
  }

  .stat {
    background: #fffaf0;
    padding: 20px;
    text-align: center;
  }

  .stat .stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }

  .stat .stat-value {
    font-family: 'Fraunces', serif;
    font-size: 32px;
    font-weight: 600;
  }

  .stat .stat-value.good { color: var(--success); }
  .stat .stat-value.bad { color: var(--accent); }

  .review-section h2 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 28px;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .review-section .subtitle {
    color: var(--ink-soft);
    margin-bottom: 28px;
    font-style: italic;
  }

  .review-item {
    background: #fffaf0;
    border: 1px solid var(--rule);
    border-left: 4px solid;
    padding: 20px 24px;
    margin-bottom: 14px;
    border-radius: 2px;
  }

  .review-item.correct { border-left-color: var(--success); }
  .review-item.wrong { border-left-color: var(--accent); }
  .review-item.skipped { border-left-color: var(--ink-soft); }

  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
    gap: 12px;
    flex-wrap: wrap;
  }

  .review-header .q-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
  }

  .review-header .status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 2px;
  }

  .status.correct { color: var(--success); background: rgba(47,107,63,.1); }
  .status.wrong { color: var(--accent); background: rgba(217,79,55,.1); }
  .status.skipped { color: var(--ink-soft); background: rgba(60,70,99,.08); }

  .review-item .q-text {
    font-family: 'Fraunces', serif;
    font-size: 17px;
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .review-answers {
    font-size: 14px;
    color: var(--ink-soft);
    display: grid;
    gap: 4px;
  }

  .review-answers strong { color: var(--ink); font-weight: 600; }
  .review-answers .answer-correct { color: var(--success); font-weight: 600; }
  .review-answers .answer-wrong { color: var(--accent); text-decoration: line-through; }

  .end-actions {
    margin-top: 48px;
    text-align: center;
  }

  /* ====== UTILS ====== */
  .hidden { display: none !important; }

  /* MATH RENDERING */
  .math {
    font-family: 'Fraunces', serif;
    font-style: italic;
  }
  .frac {
    display: inline-block;
    vertical-align: middle;
    text-align: center;
    margin: 0 2px;
  }
  .frac .num {
    display: block;
    border-bottom: 1.5px solid currentColor;
    padding: 0 4px 1px;
    font-size: 0.9em;
  }
  .frac .den {
    display: block;
    padding: 1px 4px 0;
    font-size: 0.9em;
  }
  sup { font-size: 0.75em; vertical-align: super; line-height: 0; }
  sub { font-size: 0.75em; vertical-align: sub; line-height: 0; }

  /* ====== TEASER NIVEAU 2 SUR L'ACCUEIL ====== */
  .level2-teaser {
    margin: 24px 0;
    padding: 18px 20px;
    background: linear-gradient(135deg, rgba(26,37,64,.92), rgba(26,37,64,.98));
    color: var(--paper);
    border-radius: 2px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    position: relative;
    overflow: hidden;
  }

  .level2-teaser::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: var(--accent);
  }

  .teaser-badge {
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    padding: 4px 10px;
    border: 1px solid var(--accent);
    border-radius: 2px;
    margin-top: 2px;
  }

  .teaser-content { flex: 1; font-size: 14px; line-height: 1.5; }
  .teaser-content strong { display: block; margin-bottom: 4px; color: var(--paper); font-family: 'Fraunces', serif; font-size: 16px; font-weight: 600; }
  .teaser-content span { color: rgba(244,237,224,.7); }

  /* Champ requis */
  .name-field .required { color: var(--accent); }
  .name-error {
    display: none;
    margin-top: 6px;
    font-size: 12px;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
  }
  .name-error.show { display: block; }
  .name-field input.error { border-color: var(--accent); }

  /* ====== ÉCRAN D'AVERTISSEMENT BONUS ====== */
  .warning-card {
    background: #fffaf0;
    border: 1px solid var(--ink);
    border-left: 6px solid var(--accent);
    padding: 44px 40px;
    border-radius: 2px;
    box-shadow: var(--shadow);
    position: relative;
  }

  .warning-card .warning-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
    font-weight: 600;
  }

  .warning-card h2 {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: clamp(28px, 5vw, 38px);
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .warning-card h2 em { font-style: italic; color: var(--accent); font-weight: 400; }

  .warning-card .intro-text {
    font-family: 'Fraunces', serif;
    font-size: 18px;
    color: var(--ink-soft);
    margin-bottom: 28px;
    font-style: italic;
    line-height: 1.5;
  }

  .warning-points {
    display: grid;
    gap: 14px;
    margin: 28px 0;
    padding: 20px 0;
    border-top: 1px dashed var(--rule);
    border-bottom: 1px dashed var(--rule);
  }

  .warning-point {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .warning-point .icon {
    flex-shrink: 0;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    color: var(--ink);
    font-size: 14px;
  }

  .warning-point .text { flex: 1; padding-top: 4px; font-size: 15px; line-height: 1.5; }
  .warning-point .text strong { color: var(--ink); }

  .warning-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .bonus-cta {
    margin-top: 32px;
    padding: 28px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .bonus-cta::before {
    content: "";
    position: absolute;
    top: 0; right: 0;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, rgba(217,79,55,.25), transparent 70%);
    pointer-events: none;
  }

  .bonus-cta .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
    position: relative;
  }

  .bonus-cta h3 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 28px;
    line-height: 1.15;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
    position: relative;
  }

  .bonus-cta h3 em {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  .bonus-cta p {
    color: rgba(244,237,224,.75);
    margin-bottom: 20px;
    position: relative;
    max-width: 520px;
  }

  .bonus-cta .btn {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 4px 0 var(--accent-deep);
    position: relative;
  }

  .bonus-cta .btn:hover {
    background: #fff;
    color: var(--ink);
  }

  /* Bandeau "Mode Bonus" sur l'écran quiz */
  body.bonus-mode .masthead-left h1 em { color: var(--accent); }
  body.bonus-mode {
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 31px, rgba(26,37,64,.06) 31px, rgba(26,37,64,.06) 32px),
      radial-gradient(ellipse at top right, rgba(217,79,55,.08), transparent 50%);
  }

  .bonus-banner {
    background: var(--ink);
    color: var(--paper);
    padding: 14px 20px;
    margin: -8px 0 24px;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bonus-banner .bonus-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .bonus-banner .bonus-sub {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 14px;
    color: rgba(244,237,224,.75);
  }

  .question-card.bonus-card {
    border-color: var(--ink);
    border-left: 4px solid var(--accent);
  }

  .question-card.bonus-card .level-tag {
    color: var(--accent);
    border-color: var(--ink);
    font-weight: 600;
  }

  .question-card.bonus-card .q-text {
    font-size: 19px;
    line-height: 1.5;
  }

  /* Bloc indication dans le compte-rendu bonus */
  .review-hint {
    margin-top: 12px;
    padding: 14px 16px;
    background: rgba(26,37,64,.04);
    border-left: 2px solid var(--ink-soft);
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .review-hint strong {
    color: var(--ink);
    font-weight: 600;
  }

  .review-hint .step-label {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-top: 8px;
    margin-bottom: 2px;
  }

  .review-hint .formula {
    font-family: 'Fraunces', serif;
    font-style: italic;
    padding: 2px 6px;
