          doc.setTextColor(...INK_SOFT);
          doc.setFont('helvetica', 'normal');
          doc.text('SCHÉMA EXPLICATIF', imgX, y + imgHeight + 6);
          y += imgHeight + 12;
        }
      }
      y += 4;
    }
  }

  // ====== PIED DE PAGE SUR CHAQUE PAGE ======
  const totalPages = doc.internal.getNumberOfPages();
  for (let p = 1; p <= totalPages; p++) {
    doc.setPage(p);
    doc.setFontSize(7);
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(...INK_SOFT);
    doc.text(`Page ${p} / ${totalPages}`, pageWidth - margin, pageHeight - 8, { align: 'right' });
    doc.text(`QCM Mathématiques Collège — ${state.studentName || 'élève'}`, margin, pageHeight - 8);
  }

  // ====== SAUVEGARDE ======
  const safeName = (state.studentName || 'eleve').toLowerCase().replace(/[^a-z0-9]+/gi, '-');
  const datePart = now.toISOString().slice(0, 10);
  doc.save(`resultats-qcm-maths-${safeName}-${datePart}.pdf`);
}

// ============================================================
//  ÉVÉNEMENTS
// ============================================================
els.startBtn.addEventListener('click', () => {
  const name = els.nameInput.value.trim();
  if (!name) {
    els.nameError.classList.add('show');
    els.nameInput.classList.add('error');
    els.nameInput.focus();
    return;
  }
  els.nameError.classList.remove('show');
  els.nameInput.classList.remove('error');
  state.studentName = name;
  showScreen('quiz');
  renderQuestion();
  startTimer();
});

// Le message d'erreur disparaît dès qu'on tape
els.nameInput.addEventListener('input', () => {
  if (els.nameInput.value.trim()) {
    els.nameError.classList.remove('show');
    els.nameInput.classList.remove('error');
  }
});

els.nextBtn.addEventListener('click', () => {
  if (state.currentIndex === QUESTIONS.length - 1) {
    finishQuiz();
  } else {
    state.currentIndex++;
    renderQuestion();
  }
});

els.prevBtn.addEventListener('click', () => {
  if (state.currentIndex > 0) {
    state.currentIndex--;
    renderQuestion();
  }
});

els.restartBtn.addEventListener('click', () => {
  state.currentIndex = 0;
  state.answers.fill(null);
  state.timeLeft = 3600;
  state.startedAt = null;
  state.finishedAt = null;
  els.nameInput.value = '';
  state.studentName = '';
  // Reset bonus
  state.bonusIndex = 0;
  state.bonusAnswers.fill(null);
  state.bonusCompleted = false;
  state.bonusTimeLeft = BONUS_DURATION;
  state.bonusTimeUp = false;
  if (state.bonusTimerInterval) clearInterval(state.bonusTimerInterval);
  document.body.classList.remove('bonus-mode');
  els.bonusCtaWrapper.innerHTML = '';
  els.bonusResultsWrapper.innerHTML = '';
  // Reset visuel timer
  els.timer.classList.remove('warning', 'critical');
  els.bonusTimer.classList.remove('warning', 'critical');
  showScreen('intro');
});

// ====== Avertissement bonus ======
els.startBonusConfirmBtn.addEventListener('click', startBonus);
els.backResultsBtn.addEventListener('click', () => showScreen('results'));

// ====== Téléchargement PDF ======
els.downloadBtn.addEventListener('click', downloadResultsPDF);

// ====== Niveau Bonus : navigation ======
els.bonusNextBtn.addEventListener('click', () => {
  if (state.bonusIndex === BONUS_QUESTIONS.length - 1) {
    finishBonus();
  } else {
    state.bonusIndex++;
    renderBonusQuestion();
  }
});

els.bonusPrevBtn.addEventListener('click', () => {
  if (state.bonusIndex > 0) {
    state.bonusIndex--;
    renderBonusQuestion();
  }
});

// Raccourcis clavier
document.addEventListener('keydown', (e) => {
  // Quiz principal
  if (!screens.quiz.classList.contains('hidden')) {
    if (e.key === 'ArrowRight') els.nextBtn.click();
    if (e.key === 'ArrowLeft' && !els.prevBtn.disabled) els.prevBtn.click();
    if (['1','2','3','4'].includes(e.key)) {
      const idx = parseInt(e.key) - 1;
      const radios = els.questionContainer.querySelectorAll('input[type="radio"]');
      if (radios[idx]) {
        radios[idx].checked = true;
        radios[idx].dispatchEvent(new Event('change'));
      }
    }
    return;
  }
  // Quiz bonus
  if (!screens.bonus.classList.contains('hidden')) {
    if (e.key === 'ArrowRight') els.bonusNextBtn.click();
    if (e.key === 'ArrowLeft' && !els.bonusPrevBtn.disabled) els.bonusPrevBtn.click();
    if (['1','2','3','4'].includes(e.key)) {
      const idx = parseInt(e.key) - 1;
      const radios = els.bonusContainer.querySelectorAll('input[type="radio"]');
      if (radios[idx]) {
        radios[idx].checked = true;
        radios[idx].dispatchEvent(new Event('change'));
      }
    }
  }
});
</script>

</body>
</html>
