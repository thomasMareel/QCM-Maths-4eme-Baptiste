function showScreen(name) {
  Object.values(screens).forEach(s => s.classList.add('hidden'));
  screens[name].classList.remove('hidden');
  window.scrollTo(0, 0);
}

// ============================================================
//  RENDU D'UNE QUESTION
// ============================================================
function renderQuestion() {
  const q = QUESTIONS[state.currentIndex];
  const i = state.currentIndex;

  els.questionContainer.innerHTML = `
    <div class="question-card">
      <div class="level-tag">Niveau ${q.niveau}</div>
      <div class="q-number">Question ${i + 1} sur ${QUESTIONS.length}</div>
      <div class="q-text">${q.question}</div>
      <div class="options">
        ${q.options.map((opt, idx) => `
          <label class="option">
            <input type="radio" name="answer" value="${idx}" ${state.answers[i] === idx ? 'checked' : ''}>
            <span class="opt-letter">${String.fromCharCode(65 + idx)}</span>
            <span class="opt-text">${opt}</span>
          </label>
        `).join('')}
      </div>
    </div>
  `;

  // Listeners
  els.questionContainer.querySelectorAll('input[type="radio"]').forEach(input => {
    input.addEventListener('change', e => {
      state.answers[i] = parseInt(e.target.value, 10);
    });
  });

  // Progress
  const percent = Math.round(((i + 1) / QUESTIONS.length) * 100);
  els.progressText.textContent = `Question ${i + 1} / ${QUESTIONS.length}`;
  els.progressPercent.textContent = `${percent}%`;
  els.progressFill.style.width = `${percent}%`;

  // Boutons
  els.prevBtn.disabled = i === 0;
  els.prevBtn.style.opacity = i === 0 ? '0.4' : '1';
  els.prevBtn.style.cursor = i === 0 ? 'not-allowed' : 'pointer';
  els.nextBtn.textContent = i === QUESTIONS.length - 1 ? 'Terminer ✓' : 'Suivant →';
}

// ============================================================
//  TIMER
// ============================================================
function formatTime(s) {
  if (s >= 3600) {
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    return `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
  }
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
}

function startTimer() {
  state.startedAt = Date.now();
  updateTimerDisplay();
  state.timerInterval = setInterval(() => {
    state.timeLeft--;
    updateTimerDisplay();
    if (state.timeLeft <= 0) {
      clearInterval(state.timerInterval);
      finishQuiz(true);
    }
  }, 1000);
}

function updTimerColors() {
  els.timer.classList.remove('warning', 'critical');
  if (state.timeLeft <= 300) els.timer.classList.add('critical');     // < 5 min
  else if (state.timeLeft <= 600) els.timer.classList.add('warning'); // < 10 min
}

function updateTimerDisplay() {
  els.timer.textContent = formatTime(state.timeLeft);
  updTimerColors();
}

// ============================================================
//  FIN DU QUIZ & RÉSULTATS
// ============================================================
function finishQuiz(timeUp = false) {
  if (state.timerInterval) clearInterval(state.timerInterval);
  state.finishedAt = Date.now();

  // Score
  let correctCount = 0, wrongCount = 0, skippedCount = 0;
  QUESTIONS.forEach((q, i) => {
    if (state.answers[i] === null) skippedCount++;
    else if (state.answers[i] === q.correct) correctCount++;
    else wrongCount++;
  });

  const note20 = Math.round((correctCount / QUESTIONS.length) * 20 * 10) / 10;
  els.finalScore.textContent = note20.toString().replace('.', ',');

  // Verdict
  let verdict;
  if (timeUp) verdict = `Temps écoulé. ${getVerdict(note20)}`;
  else verdict = getVerdict(note20);
  if (state.studentName) verdict = `Bravo ${state.studentName}, ${verdict.charAt(0).toLowerCase() + verdict.slice(1)}`;
  els.verdict.textContent = verdict;

  // Stats
  els.statCorrect.textContent = correctCount;
  els.statWrong.textContent = wrongCount;
  els.statSkipped.textContent = skippedCount;
  const elapsedSec = 3600 - state.timeLeft;
  els.statTime.textContent = formatTime(elapsedSec);

  // Compte-rendu
  els.reviewList.innerHTML = QUESTIONS.map((q, i) => {
    const userAns = state.answers[i];
    let status, statusLabel;
    if (userAns === null) { status = 'skipped'; statusLabel = 'Non répondu'; }
    else if (userAns === q.correct) { status = 'correct'; statusLabel = 'Correct'; }
    else { status = 'wrong'; statusLabel = 'Incorrect'; }

    const yourAnswer = userAns === null
      ? '<em>Aucune réponse</em>'
      : `<span class="${status === 'correct' ? 'answer-correct' : 'answer-wrong'}">${String.fromCharCode(65 + userAns)} — ${q.options[userAns]}</span>`;
    const goodAnswer = `<span class="answer-correct">${String.fromCharCode(65 + q.correct)} — ${q.options[q.correct]}</span>`;

    return `
      <div class="review-item ${status}">
        <div class="review-header">
          <span class="q-num">Q${i + 1} · ${q.niveau}</span>
          <span class="status ${status}">${statusLabel}</span>
        </div>
        <div class="q-text">${q.question}</div>
        <div class="review-answers">
          ${userAns !== null && userAns !== q.correct
            ? `<div><strong>Ta réponse :</strong> ${yourAnswer}</div><div><strong>Bonne réponse :</strong> ${goodAnswer}</div>`
            : userAns === null
              ? `<div><strong>Bonne réponse :</strong> ${goodAnswer}</div>`
