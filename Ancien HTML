const BONUS_QUESTIONS = [
  // 1 — Pythagore (réciproque)
  { question: 'Un triangle <span class="math">ABC</span> est tel que <span class="math">AB = 6 cm</span>, <span class="math">AC = 8 cm</span> et <span class="math">BC = 10 cm</span>. Que peut-on en déduire ?',
