// ============================================================
//  TÉLÉCHARGEMENT PDF
// ============================================================
function stripHTML(html) {
  // Convertit HTML simple (math, frac, sup, sub) en texte plat lisible
  const tmp = document.createElement('div');
  tmp.innerHTML = html;
  // Gérer les fractions
  tmp.querySelectorAll('.frac').forEach(f => {
    const num = f.querySelector('.num')?.textContent || '';
    const den = f.querySelector('.den')?.textContent || '';
    f.replaceWith(`(${num}/${den})`);
  });
  // Gérer les exposants
  tmp.querySelectorAll('sup').forEach(s => s.replaceWith(`^${s.textContent}`));
  tmp.querySelectorAll('sub').forEach(s => s.replaceWith(`_${s.textContent}`));
  return tmp.textContent.replace(/\s+/g, ' ').trim();
}

function svgToPngDataURL(svgString, width = 280, height = 200) {
  return new Promise((resolve) => {
    const svg = svgString.trim();
    const svg64 = btoa(unescape(encodeURIComponent(svg)));
    const image64 = 'data:image/svg+xml;base64,' + svg64;
    const img = new Image();
    img.onload = function() {
      const canvas = document.createElement('canvas');
      const scale = 2; // résolution doublée pour netteté
      canvas.width = width * scale;
      canvas.height = height * scale;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#fffefa';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      resolve(canvas.toDataURL('image/png'));
    };
    img.onerror = () => resolve(null);
    img.src = image64;
  });
}

